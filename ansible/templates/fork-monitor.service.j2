[Unit]
Description=Fork Monitor for {{ ethereum_network_name }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/fork-monitor/fork-monitor /opt/fork-monitor/config.toml
Restart=always
RestartSec=10
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
